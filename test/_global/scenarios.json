{
  "full_collection": {
    "image": "registry.fedoraproject.org/fedora-minimal:latest",
    "features": {
      "with-base": {},
      "podman": {},
      "podman-in-podman": {},
      "poop": {},
      "with-podman": {},
      "git": {},
      "nvm": {},
      "node": {},
      "dotagents": {}
    },
    "containerEnv": {
      "POOP_SOCKET": "/root/.poop/poop",
      "CONTAINER_HOST": "unix:///root/.poop/poop",
